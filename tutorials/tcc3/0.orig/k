FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 4.5;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    staticWall
    {
        type            kqRWallFunction;
        value           uniform 0;
    }

    movingWall
    {
        $staticWall;
    }

    inlet
    {
        type            turbulentKineticEnergy;
        intensity       0.1;
        value           uniform 0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}


