FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      tracer;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField
{
    type    zonal;
    defaultValue 0;

    zones
    {
        intakePort
        {
            type    lookup;
            value   1;
        }
    }
}

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    staticWall
    {
        type            zeroGradient;
    }

    movingWall
    {
        $staticWall;
    }

    outlet
    {
        $staticWall;
    }

    inlet
    {
        type          fixedValue;
        value         uniform 1.0;
    }
}


