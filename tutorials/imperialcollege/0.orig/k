FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.387508501176374;

boundaryField
{

    staticWall
    {
        type            kLowReWallFunction;
        value           $internalField;
    }

    movingWall
    {
        $staticWall
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}


