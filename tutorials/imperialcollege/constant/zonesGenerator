FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      zonesGenerator;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A combustionChamber cellZone for calculating pressure, temperature etc.
chamber
{
    $engineDict!meshControl/regionRefinement/chamber
    zoneType    cell;
}

coneRefinement
{
    $engineDict!meshControl/regionRefinement/coneRefinement
    zoneType    point;
}

cylinderHead
{
    type        cylinderHeadPoints;
}

pistonBowl
{
    type        pistonBowlPoints;
}

