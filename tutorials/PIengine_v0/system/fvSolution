FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    rho
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-08;
        relTol          0;
    }

    rhoFinal
	{
        $rho;
    }
    p
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        relTol          1e-3;
        tolerance       1e-10;
        minIter         1;
  }

    pFinal
    {
        $p;
        relTol 0;
    }

    "(U|h|e|k|epsilon|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.001;
        minIter	1;
    }

    "(Yi|tracer)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.001;
    }

    "(U|h|e|k|epsilon|omega)Final"
    {

        $U;
        relTol          0;
    }
    "(Yi|tracer)Final"
    {
        $Yi;
        relTol  0;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-2;
        relTol          0;
    }
}

PIMPLE
{
    transonic           yes;
    nOuterCorrectors    1;
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;
    correctPhi          yes;
    correctMeshPhi      no;
    checkMeshCourantNo  no;
}

relaxationFactors
{
    equations
    {
        ".*"        1;
    }
}


