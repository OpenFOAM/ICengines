FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    movingWall
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    staticWall
    {
        type            noSlip;
    }

    outlet
    {
        type            pressureInletOutletVelocity; //inflow, comes with totalPressure
	    value           $internalField;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}


