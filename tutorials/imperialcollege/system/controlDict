FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          fluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2160;

deltaT          0.5;

writeControl    adjustableRunTime;

writeInterval   20;

purgeWrite      5;

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

adjustTimeStep  yes;

maxCo           5;

maxDeltaT       1;

userTime
{
    type            engine;
    rpm             200;
}

libs            ( "libsearchableSurfaces_w.so" );
