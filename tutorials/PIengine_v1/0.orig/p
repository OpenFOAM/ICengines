FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField
{
    type        zonal;

    // État initial ESTIMÉ (décision utilisateur, moteur « motored » froid,
    // pas de combustion en v0) : ambiance partout. A affiner si besoin.
    defaultValue    1 [bar];

    zones
    {
        chamber
        {
            type            lookup;

            value           1 [bar];
        }

        intakePort
        {
            type            lookup;

            value           0.95 [bar];
        }

        exhaustPort
        {
            type            lookup;

            value           1 [bar];
        }
    }
}

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    staticWall
    {
        type            zeroGradient;
    }

    movingWall
    {
        type        fixedFluxPressure;
    }

    // Pressions aux bornes CONSTANTES (décision utilisateur : pas de tables
    // CSV en fonction du CAD). Un simple uniformTotalPressure suffit — pour
    // repasser aux tables, rétablir la syntaxe de tcc3 (p0 { type table; ... }).
    outlet
    {
        type            uniformTotalPressure;
        U               U;
        phi             phi;
        rho             rho;
        gamma           1.4;
        p0              uniform 100000;   // 1 bar (échappement)
    }

    inlet
    {
        $outlet;
        p0              uniform 95000;    // 0.95 bar (admission)
    }
}


