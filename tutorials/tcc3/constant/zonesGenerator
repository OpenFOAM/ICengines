FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      zonesGenerator;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A combustionChamber cellZone for calculating pressure, temperature etc.
chamber
{
    $engineDict!meshControl/regionRefinement/chamber
    zoneType    cell;
}

intakePort
{
    type            box;
    box             (-0.017  0.0113  0.001)  (0.129  0.045  0.079);
    zoneType        cell;
}

exhaustPort
{
    type            box;
    box             (-0.017  -0.05  0.001)  (0.017  -0.0012  0.079);
    zoneType        cell;
}


// cylinderHead and pistonBowl pointZones for mesh mover control
// define pistonBowl so that the pistonBowl is NOT frozen
// near TDC to control deformation better
cylinderHead
{
    type        cylinderHeadPoints;
    moveUpdate  true;
}

pistonBowl
{
    type        periodic;
    begin       -40;
    end         40;
    deactivate  true;
    repeat      720;
    pistonBowl
    {
        type        pistonBowlPoints;
    }
}

