FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField
{
    type    zonal;
    defaultValue 1;

    zones
    {
        chamber
        {
            type    lookup;
            value   0;
        }
    }
}

boundaryField
{
    staticWall
    {
        type            zeroGradient;
    }

    movingWall
    {
        $staticWall
    }

    outlet
    {
        type            fixedValue;
        value           uniform 1;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}


