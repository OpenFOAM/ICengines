#includeEtc "caseDicts/functions/surface/surface.cfg"
writeControl    adjustableRunTime;
writeInterval   2;
surfaceFormat       vtk;
fields              (p T U rho tracer);
surfaces
{
    xNormal
    {
        type               cuttingPlane;
        point (0 0 0);
        normal (1 0 0);
        interpolate        true;
        cellZone        chamber;
    }

    yNormal
    {
        type               cuttingPlane;
        point (0 0 0);
        normal (0 1 0);
        interpolate        true;
    }

    intakePort
    {
        type               cuttingPlane;
        point   (0.028 0 0);
        normal  (1 0 0);
        interpolate        true;
        cellZone    intakePort;
    }

    exhaustPort
    {
        type               cuttingPlane;
        point   (-0.028 0 0);
        normal  (1 0 0);
        interpolate        true;
        cellZone        exhaustPort;
    }

    zNormal5
    {
        type               cuttingPlane;
        point   (0 0 -0.05);
        normal (0 0 1);
        interpolate        true;
        cellZone        chamber;
    }

    zNormal30
    {
        type               cuttingPlane;
        point   (0 0 -0.03);
        normal (0 0 1);
        interpolate        true;
        cellZone        chamber;
    }

};




