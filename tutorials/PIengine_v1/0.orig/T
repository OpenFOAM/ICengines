FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField
{
    type        zonal;

    // État initial ESTIMÉ (décision utilisateur, moteur « motored » froid) :
    // ambiance partout, l'échappement un peu plus chaud (gaz résiduels).
    defaultValue    300;

    zones
    {
        chamber
        {
            type            lookup;

            value           300;
        }

        intakePort
        {
            type            lookup;

            value           $defaultValue;
        }

        exhaustPort
        {
            type            lookup;

            value           350;
        }
    }
}

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    staticWall
    {
        type          fixedValue;
        value         uniform 300;     // parois froides (motored)
    }

    movingWall
    {
        $staticWall;
    }

    inlet
    {
        type                uniformInletOutlet;
        uniformInletValue   $internalField/defaultValue;
    }

    outlet
    {
        type          zeroGradient;
    }
}


