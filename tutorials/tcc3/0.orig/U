FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);
//default     staticWall;
// I set piston and valve to movingWall
// I set inlet and outlet to inletOutlet
boundaryField
{
    staticWall
    {
        type            noSlip;
    }

    movingWall
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }


    inlet
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        value           uniform (0 0 0);
    }

    outlet
    {
        $inlet
    }

    // for the NCC case
    #includeEtc "caseDicts/setConstraintTypes"
    "ncc.*"
    {
        type            slip;
    }
}


